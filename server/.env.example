# Copy to server/.env and replace placeholders with your genuine values.
PORT=5050
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=your_secure_jwt_secret_hex_or_random_bytes
# Generate 32 random bytes as 64 hex characters (e.g. node -e "console.log(crypto.randomBytes(32).toString('hex'))")
ENC_KEY=your_64_character_hex_encryption_key_here
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional Firebase Admin / Firestore sync (set ONE if using Firebase)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=

# Meta Facebook Application (from Meta for Developers > TrustLoom AI > App settings > Basic)
META_APP_ID=your_meta_facebook_app_id
META_APP_SECRET=your_meta_facebook_app_secret
META_GRAPH_VERSION=v26.0
# Must match a registered Valid OAuth Redirect URI in Facebook Login settings
META_REDIRECT_URI=https://your-domain.ngrok-free.dev/api/integrations/meta/callback

# Instagram Application (from Meta for Developers > TrustLoom > Use cases > Instagram API > API setup with Instagram login)
# Note: Use the dedicated Instagram App ID (NOT the parent Facebook App ID)
META_INSTAGRAM_APP_ID=your_instagram_app_id
META_INSTAGRAM_APP_SECRET=your_instagram_app_secret
# Must match a registered Valid OAuth Redirect URI in Instagram Login settings
META_INSTAGRAM_REDIRECT_URI=https://your-domain.ngrok-free.dev/api/integrations/instagram/callback

# X (Twitter) API OAuth 2.0 with PKCE (from X Developer Portal > Projects & Apps)
X_CLIENT_ID=your_x_oauth2_client_id
X_CLIENT_SECRET=your_x_oauth2_client_secret_optional
X_REDIRECT_URI=https://your-domain.ngrok-free.dev/api/integrations/x/callback

